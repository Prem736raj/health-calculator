<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only generated, user-requested exports are shareable. Keep the rest of
         the cache (including diagnostics and image caches) private. -->
    <cache-path
        name="exports"
        path="exports/" />

    <!-- Durable, app-private user images selected/captured for profiles. -->
    <files-path
        name="profile_images"
        path="profile_images/" />

</paths>

